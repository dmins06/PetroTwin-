{
  "name": "PetroTwin M2",
  "initializeCommand": "bash \"${localWorkspaceFolder}/.devcontainer/generate_mysql_env.sh\"",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postCreateCommand": "python -m pip install -e '.[eda,mysql]' && bash .devcontainer/setup_mysql_client.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
